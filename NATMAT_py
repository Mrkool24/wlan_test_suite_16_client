class FileVerifier:
    def __init__(self, device_config: Dict[str, Dict], serial_port: str = None):
        self.device_config = device_config
        self.missing_files = {}
        self.verified_files = {}
        self.serial_port = serial_port or '/dev/ttyUSB0'

    def check_file_exists(self, file_path: str, remote_host: str = None) -> bool:
        if remote_host:
            cmd = f"test -e {shlex.quote(file_path)} && echo ok || echo missing"
            out, err, rc, to = execute_command(cmd, remote_host=remote_host, timeout=10)
            return out.strip() == "ok"
        else:
            return os.path.isfile(file_path)

    def create_directory_remote(self, dir_path: str, remote_host: str) -> bool:
        cmd = f"mkdir -p {shlex.quote(dir_path)}"
        out, err, rc, to = execute_command(cmd, remote_host=remote_host, timeout=10)
        if rc == 0:
            print(f"  ? Created remote directory: {dir_path}")
            return True
        else:
            print(f"  ? Failed to create remote directory: {err}")
            return False

    def create_file_remote(self, file_path: str, content: str, remote_host: str,
                           executable: bool = False) -> bool:
        try:
            b64_content = base64.b64encode(content.encode()).decode()
            chmod_part = f" && chmod +x {shlex.quote(file_path)}" if executable else ""
            cmd = f"echo '{b64_content}' | base64 --decode > {shlex.quote(file_path)}{chmod_part}"
            out, err, rc, to = execute_command(cmd, remote_host=remote_host, timeout=30)
            if rc == 0:
                print(f"  ? Created file: {file_path}")
                return True
            else:
                print(f"  ? Failed to create file: {err}")
                return False
        except Exception as e:
            print(f"  ? Error creating file: {e}")
            return False

    def create_nat_sh_remote(self, file_path: str, enet_mac: str, dut_mac: str, dut_ip: str, remote_host: str) -> bool:
        try:
            command_hex = build_hex_command(enet_mac, dut_mac, dut_ip)
            nat_sh_content = f'''#!/bin/bash
COMMAND="{command_hex}"
if [ "$1" == "ka" ]; then
   ./wl keep_alive $2 $COMMAND
elif [ "$1" == "mka" ]; then
   ./wl mkeep_alive 1 $2 $COMMAND
elif [ "$1" == "mkai" ]; then
   ./wl mkeep_alive 1 immediate $2 $COMMAND
fi
'''
            b64_content = base64.b64encode(nat_sh_content.encode()).decode()
            cmd = f"echo '{b64_content}' | base64 --decode > {shlex.quote(file_path)} && chmod +x {shlex.quote(file_path)}"
            out, err, rc, to = execute_command(cmd, remote_host=remote_host, timeout=30)
            if rc == 0:
                print(f"  ? Created and made executable: {file_path}")
                return True
            else:
                print(f"  ? Failed to create NAT.sh: {err}")
                return False
        except Exception as e:
            print(f"  ? Error creating NAT.sh: {e}")
            return False

    def auto_create_missing_files(self, device_name: str, remote_host: str = None,
                                   enet_mac: str = None, dut_mac: str = None, dut_ip: str = None) -> bool:
        if device_name not in self.device_config:
            return False
        device_info = self.device_config[device_name]
        base_path = device_info.get('path', '')
        missing = self.missing_files.get(device_name, [])
        if not missing:
            return True
        print(f"\n?? Auto-creating missing files for '{device_name}'...\n")
        for file_name in missing:
            full_path = os.path.join(base_path, file_name)
            if file_name == 'TMconfig.py':
                content = TMCONFIG_PY.format(serial_port=self.serial_port)
                if not self.create_file_remote(full_path, content, remote_host):
                    return False
            elif file_name == 'TMsec.py':
                content = TMSEC_PY.format(serial_port=self.serial_port)
                if not self.create_file_remote(full_path, content, remote_host):
                    return False
            elif file_name == 'assoc.sh':
                if not self.create_file_remote(full_path, ASSOC_SH, remote_host, executable=True):
                    return False
            elif file_name == 'NAT.sh':
                if not enet_mac or not dut_mac or not dut_ip:
                    print(f"  ? NAT.sh requires enet_mac, dut_mac, and dut_ip parameters")
                    return False
                if not self.create_nat_sh_remote(full_path, enet_mac, dut_mac, dut_ip, remote_host):
                    return False
            elif file_name.endswith('/'):
                if not self.create_directory_remote(full_path.rstrip('/'), remote_host):
                    return False
        if remote_host:
            cmd = f"find {shlex.quote(base_path)} -name '*.sh' -type f -exec chmod +x {{}} \\;"
            out, err, rc, to = execute_command(cmd, remote_host=remote_host, timeout=10)
            if rc == 0:
                print(f"  ? Made all .sh files executable in {base_path}")
            else:
                print(f"  ??  Warning: Could not set executable permissions: {err}")
        return True

    def verify_device_files(self, device_name: str, remote_host: str = None) -> Tuple[bool, List[str]]:
        if device_name not in self.device_config:
            print(f"  ??  Device '{device_name}' not found in configuration.")
            return False, []
        device_info = self.device_config[device_name]
        base_path = device_info.get('path', '')
        required_files = device_info.get('required_files', [])
        if remote_host:
            self.create_directory_remote(base_path, remote_host)
        if not required_files:
            print(f"  ? No required files configured for '{device_name}'")
            return True, []
        missing = []
        present = []
        for file_name in required_files:
            if not file_name:
                continue
            full_path = os.path.join(base_path, file_name)
            if self.check_file_exists(full_path, remote_host=remote_host):
                present.append(file_name)
                print(f"    ? Found: {full_path}")
            else:
                missing.append(file_name)
                print(f"    ? Missing: {full_path}")
        self.verified_files[device_name] = present
        self.missing_files[device_name] = missing
        return len(missing) == 0, missing

    def verify_all_devices(self, device_ips: Dict[str, Optional[str]] = None) -> bool:
        if device_ips is None:
            device_ips = {}
        print("\n" + "="*70)
        print("?? VERIFYING REQUIRED FILES ACROSS ALL DEVICES")
        print("="*70 + "\n")
        all_verified = True
        for device_name in self.device_config.keys():
            remote_ip = device_ips.get(device_name)
            if remote_ip is None:
                print(f"?  Skipping '{device_name}' (not configured)\n")
                continue
            print(f"?? Checking Remote Device: '{device_name}' ({remote_ip})")
            print("-" * 70)
            is_verified, missing = self.verify_device_files(device_name, remote_host=remote_ip)
            if not is_verified:
                all_verified = False
            print()
        return all_verified

    def handle_missing_files_with_auto_create(self, device_ips: Dict[str, Optional[str]] = None) -> bool:
        if device_ips is None:
            device_ips = {}
        devices_with_missing = [d for d, files in self.missing_files.items() if files]
        if not devices_with_missing:
            print("\n? All required files are present! Proceeding with execution...")
            return True
        print(f"\n??  Files missing on {len(devices_with_missing)} device(s)")
        print("?? AUTO-CREATING MISSING FILES...\n")
        enet_mac = None
        dut_mac = None
        dut_ip_for_nat = None
        for device_name in devices_with_missing:
            if 'NAT.sh' in self.missing_files.get(device_name, []):
                print("\n?? NAT.sh requires additional inputs:\n")
                enet_mac = input("Enter ENET MAC (e.g., f8:e4:3b:af:bf:d7): ").strip()
                dut_mac = input("Enter DUT MAC (e.g., f8:e4:3b:af:bf:d7): ").strip()
                dut_ip_for_nat = input("Enter DUT IP (e.g., 192.168.1.10): ").strip()
                break
        for device_name in devices_with_missing:
            remote_ip = device_ips.get(device_name)
            if remote_ip is None:
                continue
            print(f"\n?? Processing device: '{device_name}'")
            print("-" * 70)
            if not self.auto_create_missing_files(device_name, remote_host=remote_ip,
                                                   enet_mac=enet_mac, dut_mac=dut_mac, dut_ip=dut_ip_for_nat):
                print(f"\n? FATAL: Failed to create files on '{device_name}'")
                return False
        print("\n? All missing files have been created successfully!")
        return True

# ============================================================================
# MAIN EXECUTION FUNCTIONS
# ============================================================================
def execute_command(command, remote_host=None, new_terminal=False, terminal_name=None, timeout=None):
    skip_printing = command.endswith(", dp")
    if skip_printing:
        command = command[:-4]
    if remote_host:
        full_command = f"ssh root@{remote_host} '{command}'"
    else:
        full_command = command
    print(f"Executing: {full_command}")
    if new_terminal:
        if terminal_name:
            full_command = f"gnome-terminal --title=\"{terminal_name}\" -- bash -c \"{full_command}; exec bash\""
        else:
            full_command = f"gnome-terminal -- bash -c \"{full_command}; exec bash\""
        try:
            proc = subprocess.run(full_command, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
            return proc.stdout.decode(), proc.stderr.decode(), proc.returncode, False
        except subprocess.TimeoutExpired:
            return "", f"Timed out after {timeout} seconds", -1, True
    else:
        proc = subprocess.Popen(full_command, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        try:
            output, error = proc.communicate(timeout=timeout)
            if not skip_printing:
                if output:
                    print(output.decode())
                if error:
                    print(error.decode())
            return output.decode(), error.decode(), proc.returncode, False
        except subprocess.TimeoutExpired:
            proc.kill()
            try:
                output, error = proc.communicate(timeout=5)
            except subprocess.TimeoutExpired:
                output, error = b"", b""
            out_decoded = output.decode() if output else ""
            err_decoded = error.decode() if error else ""
            print(f"Command timed out after {timeout} seconds; process killed.")
            if out_decoded and not skip_printing:
                print(out_decoded)
            if err_decoded and not skip_printing:
                print(err_decoded)
            return out_decoded, err_decoded, -1, True

def append_text_to_file_on_tm(tm_ip, remote_main_file, label, text):
    b64 = base64.b64encode(text.encode()).decode()
    quoted_label = shlex.quote(f"--- {label} ---")
    cmd = (
        f"echo {quoted_label} >> {shlex.quote(remote_main_file)} && "
        f"echo {shlex.quote(b64)} | base64 --decode >> {shlex.quote(remote_main_file)} && "
        f"echo '' >> {shlex.quote(remote_main_file)}"
    )
    out, err, rc, to = execute_command(cmd, remote_host=tm_ip, timeout=30)
    if rc != 0:
        raise RuntimeError(f"Failed to append to {remote_main_file} on {tm_ip}: rc={rc}, err={err}")

def q(s):
    return shlex.quote(str(s))

def remote_file_exists(remote_host, path):
    cmd = f"test -e {q(path)} && echo ok || echo missing"
    out, err, rc, to = execute_command(cmd, remote_host=remote_host, timeout=10)
    return out.strip() == "ok"

def NATKA(title, mode, intf, SSID, ch, sec, tm_ip, dut_ip, dut_build_path='/build',
          is_5312=False, dut_serial_port=None, hex_cmd=None):
    main_output_file = "/root/NATMATKA/Results/Main_Output_File.txt"
    pcap_dir = "/root/NATMATKA/"
    capture_duration = 25

    if not tm_ip:
        raise RuntimeError("NATKA called with empty tm_ip  aborting.")
    if is_5312 and not dut_serial_port:
        raise RuntimeError("5312 mode requires dut_serial_port.")
    if is_5312 and not hex_cmd:
        raise RuntimeError("5312 mode requires hex_cmd for NAT commands.")
    if not is_5312 and not dut_ip:
        raise RuntimeError("NATKA called with empty dut_ip  aborting.")

    def run_or_raise(cmd, host, timeout=60, desc=None):
        if not host:
            raise RuntimeError(f"run_or_raise called with empty host for cmd: {cmd!r}")
        out, err, rc, timed_out = execute_command(cmd, remote_host=host, timeout=timeout)
        ok = (rc == 0 and not timed_out)
        if not ok:
            err = (err or "") + (f"\n[CMD] {cmd}\n[RC] {rc}\n[TIMEOUT] {timed_out}\n")
        return ok, out, err, rc, timed_out

    # Log start
    run_or_raise(f"echo 'Starting test case: {title}' >> {q(main_output_file)}", tm_ip, timeout=10)

    # Configure TM (same for both chip types)
    run_or_raise(f"cd /root/NATMATKA && python3 TMconfig.py {q(intf)} {q(ch)}", tm_ip, timeout=30)
    run_or_raise(f"cd /root/NATMATKA && python3 TMsec.py {q(intf)} {q(sec)}, dp", tm_ip, timeout=None)

    if is_5312:
        # ---- 5312 DUT flow ----
        serial_assoc_5312(dut_serial_port, SSID, sec)
        time.sleep(20)
        dut_status = rwl_wl_command(tm_ip, "status")
        if dut_status:
            append_text_to_file_on_tm(tm_ip, main_output_file, f"{title} - DUT status", dut_status)
        serial_ifconfig_5312(dut_serial_port)
        nat_5312(dut_serial_port, mode, 0, hex_cmd)
        time.sleep(1)
        nat_5312(dut_serial_port, mode, 3000, hex_cmd)
    else:
        # ---- Non-5312 DUT flow ----
        run_or_raise(f"cd {dut_build_path} && bash assoc.sh {q(SSID)} {q(sec)}", dut_ip, timeout=30)
        time.sleep(20)
        wl_out, wl_err, rc, to = execute_command("sleep 5 && wl -i wlan0 status", remote_host=dut_ip, timeout=30)
        dut_status = wl_out.strip() or wl_err.strip()
        if dut_status:
            append_text_to_file_on_tm(tm_ip, main_output_file, f"{title} - DUT status", dut_status)
        run_or_raise("ifconfig wlan0 192.168.1.10", dut_ip, timeout=10)
        nat_base = 30
        nat_timeout = nat_base + 60
        run_or_raise(f"cd {dut_build_path} && ./NAT.sh {mode} 0 && sleep 1 && ./NAT.sh {mode} 3000", dut_ip, timeout=nat_timeout)

    # ---- tcpdump on TM (same for both chip types) ----
    log_path = f"{pcap_dir}/{title}_tcpdump.log"
    tcpdump_cmd = (
        f"cd {q(pcap_dir)} && timeout 30s tcpdump -i eth1 -s 0 -U -n "
        f"> {q(log_path)} 2>/tmp/tcpdump_err_{int(time.time())}.log &"
    )
    execute_command(tcpdump_cmd, remote_host=tm_ip, timeout=None)
    print(f"? Waiting for capture to complete ({capture_duration} seconds)...\n")
    time.sleep(capture_duration + 3)

    if not remote_file_exists(tm_ip, log_path):
        raise RuntimeError(f"tcpdump log not found on TM: {log_path}")

    out, err, rc, to = execute_command(f"stat -c %s {q(log_path)}", remote_host=tm_ip, timeout=10)
    size = int(out.strip() or 0)
    print(f"?? TCPDUMP CAPTURE RESULTS:\n  ? File size: {size} bytes\n")
    if size == 0:
        raise RuntimeError(f"tcpdump log {log_path} exists but is empty on {tm_ip}")

    run_or_raise(f"echo {q(f'--- {title} (tcpdump log) ---')} >> {q(main_output_file)}", tm_ip, timeout=10)
    run_or_raise(f"cat {q(log_path)} >> {q(main_output_file)}", tm_ip, timeout=10)
    run_or_raise(f"echo '' >> {q(main_output_file)}", tm_ip, timeout=5)
    print(f"? tcpdump log saved and appended to main output file\n")

    # ---- Cleanup ----
    time.sleep(35)
    if is_5312:
        nat_5312(dut_serial_port, mode, 0, hex_cmd)
    else:
        run_or_raise(f"cd {dut_build_path} && ./NAT.sh {mode} 0", dut_ip, timeout=10)

