def serial_send_command(port: str, command: str, baud: int = 230400, wait: float = 2.0) -> str:
    """Send a single command over serial and return output."""
    print(f"[SERIAL] {port} <- {command}")
    with serial.Serial(port, baud, timeout=wait) as ser:
        time.sleep(0.5)
        ser.write((command + '\n').encode('utf-8'))
        time.sleep(wait)
        output = b""
        while ser.in_waiting > 0:
            output += ser.read(ser.in_waiting)
            time.sleep(0.1)
    decoded = output.decode('utf-8', errors='replace')
    print(f"[SERIAL] output: {decoded}")
    return decoded

def serial_assoc_5312(dut_serial_port: str, ssid: str, sec: str):
    """Associate 5312 DUT to AP via serial. Verify with wifi connectstatus. Retry up to 2 times."""
    PASSWORD = "9876543210"
    sec_map = {"open": "0", "wpa2": "1", "wpa3": "2"}
    sec_num = sec_map.get(sec)
    if sec_num is None:
        raise RuntimeError(f"Unknown security type for 5312: {sec}")
    if sec == "open":
        assoc_cmd = f"wifi connect {ssid} {sec_num}"
    else:
        assoc_cmd = f"wifi connect {ssid} {sec_num} {PASSWORD}"

    max_attempts = 3
    for attempt in range(1, max_attempts + 1):
        print(f"[5312] Association attempt {attempt}/{max_attempts}")
        serial_send_command(dut_serial_port, assoc_cmd, wait=10.0)
        time.sleep(3)
        status_out = serial_send_command(dut_serial_port, "wifi connectstatus", wait=3.0)
        if "STATUS: CONNECTED" in status_out:
            print(f"[5312] Connected on attempt {attempt}")
            return
        print(f"[5312] Not connected. Output: {status_out.strip()}")

    raise RuntimeError(f"[5312] DUT failed to associate after {max_attempts} attempts  marking FAIL")

def serial_ifconfig_5312(dut_serial_port: str, ip: str = "192.168.1.10"):
    """Set IP on 5312 DUT via serial."""
    serial_send_command(dut_serial_port, f"wifi ifconfig sta {ip}", wait=3.0)

def rwl_wl_command(tm_ip: str, wl_cmd: str) -> str:
    """Issue a wl command to 5312 DUT via TM RWL path."""
    ssh_cmd = f"cd /root/5312_BetaRC1 && ./RWL.sh && ./wl -i sta --serial /dev/ttyUSB3 --baud 230400 \"{wl_cmd}\""
    out, err, rc, to = execute_command(ssh_cmd, remote_host=tm_ip, timeout=30)
    return out.strip() or err.strip()

def build_hex_command(enet_mac: str, dut_mac: str, dut_ip: str) -> str:
    """Build NAT hex packet string."""
    enet_mac_clean = enet_mac.replace(":", "")
    dut_mac_clean  = dut_mac.replace(":", "")
    ip_parts = dut_ip.split('.')
    ip_hex = ''.join([f'{int(o):02X}' for o in ip_parts])
    receiver_ip = "FFFFFFFF"
    return f"0x{enet_mac_clean}{dut_mac_clean}08004500001E000040004011C52A{ip_hex}{receiver_ip}13C413C4000A00000A0D"

def nat_5312(dut_serial_port: str, mode: str, interval: int, hex_cmd: str):
    """Send wifi mkeep_alive command via serial on 5312 DUT."""
    if mode == "mkai":
        cmd = f"wifi mkeep_alive 0 immediate {interval} {hex_cmd}"
    else:
        cmd = f"wifi mkeep_alive 0 {interval} {hex_cmd}"
    serial_send_command(dut_serial_port, cmd, wait=3.0)

